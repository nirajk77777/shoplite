# Both come from the incident-resolver repository's docker compose stack.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/incident_resolver
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# API process
PORT=4000
HOST=0.0.0.0
LOG_LEVEL=info

# Storefront dev server
WEB_PORT=4001
SHOPLITE_API_URL=http://localhost:4000
# Where the storefront dev server forwards /portal/* : the Incident Resolver portal API
PORTAL_API_URL=http://localhost:5000

# Container only. Set by the Dockerfile, which makes the API process serve the built
# storefront too and moves the store's own routes under /api. Unset locally, where the
# Vite dev server serves the pages instead.
# WEB_DIST_DIR=/app/apps/web/dist
# Container only. Truncates and reseeds the store on start. Leave unset except for a
# first boot against an empty database.
# SEED_ON_START=true
